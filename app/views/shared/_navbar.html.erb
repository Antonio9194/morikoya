<div class="navbar navbar-expand-lg navbar-light navbar-lewagon">
  <div class="container-fluid">
    <!-- Left: Home -->
    <%= link_to root_path, class: "navbar-brand" do %>
      <%= image_tag "logo.png", alt: "Minakoya Logo" %>
    <% end %>
    <!-- Center: Nav Links -->
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarExternalContent" aria-controls="navbarExternalContent" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarExternalContent">
      <ul class="navfoot navbar-nav">
        <!-- Language Dropdown (Mobile) -->
        <li class="nav-item dropdown pwa-visible">
          <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="navbarDropdownLangMobile" role="button" data-bs-toggle="dropdown" aria-expanded="false">
             <i class="bi bi-globe me-1"></i>
             <%= I18n.locale.to_s.upcase %>
          </a>
          <ul class="dropdown-menu" aria-labelledby="navbarDropdownLangMobile">
            <li><%= button_to "English", set_locale_path(locale: :en), method: :post, class: "dropdown-item #{'active' if I18n.locale == :en}" %></li>
            <li><%= button_to "日本語", set_locale_path(locale: :ja), method: :post, class: "dropdown-item #{'active' if I18n.locale == :ja}" %></li>
            <li><%= button_to "한국어", set_locale_path(locale: :ko), method: :post, class: "dropdown-item #{'active' if I18n.locale == :ko}" %></li>
            <li><%= button_to "中文", set_locale_path(locale: "zh-CN"), method: :post, class: "dropdown-item #{'active' if I18n.locale.to_s == 'zh-CN'}" %></li>
            <li><%= button_to "繁體中文", set_locale_path(locale: "zh-TW"), method: :post, class: "dropdown-item #{'active' if I18n.locale.to_s == 'zh-TW'}" %></li>
          </ul>
        </li>
        <!--Navbar content when user is not signed in-->
        <% unless user_signed_in? %>
          <li class="nav-item">
            <%= link_to rooms_path, class: "nav-link d-flex align-items-center" do %>
              <%= image_tag "rooms.png", style: "width: 20px; height: 20px;", class: "collapsed-size-16 rooms-icon" %>
              <%= t("navbar.rooms")%>
            <% end %>
          </li>
          <li class="nav-item">
            <%= link_to new_contact_message_path, class: "nav-link d-flex align-items-center" do %>
              <%= image_tag "contact.png", style: "width: 20px; height: 20px;", class: "collapsed-size-16 contact-icon" %>
              <%= t("navbar.contact_us")%>
            <% end %>
          </li>
          <li class="nav-item">
            <%= link_to about_us_path, class: "nav-link d-flex align-items-center" do %>
              <%= image_tag "about.png", style: "width: 25px; height: 25px;", class: "me-1 collapsed-size-20" %>
              <%= t("navbar.about_us")%>
            <% end %>
          </li>
          <li class="nav-item">
            <%= link_to faqs_path, class: "nav-link d-flex align-items-center" do %>
              <%= image_tag "faq.png", style: "width: 23px; height: 23px;", class: "me-1 collapsed-size-20" %>
              <%= t("navbar.faqs")%>
            <% end %>
          </li>
          <li class="nav-item pwa-visible">
            <%= link_to new_user_session_path, class: "nav-link d-flex align-items-center" do %>
              <%= image_tag "login.png", style: "width: 20px; height: 20px;", class: "collapsed-size-16 login-icon" %>
              <%= t("navbar.login")%>
            <% end %>
          </li>
        <% end %>
        <!---->
        <!--When user is signed in and is admin-->
        <% if user_signed_in? && current_user.admin? %>
          <li class="nav-item">
            <%= link_to rooms_path, class: "nav-link d-flex align-items-center" do %>
              <%= image_tag "rooms.png", style: "width: 20px; height: 20px;", class: "me-1" %>
              <%= t("navbar.rooms")%>
            <% end %>
          </li>
          <li class="nav-item">
            <%= link_to admin_bookings_path, class: "nav-link d-flex align-items-center" do %>
              <%= image_tag "bookings.png", style: "width: 20px; height: 20px;", class: "me-1" %>
              <%= t("navbar.bookings")%>
            <% end %>
          </li>
          <li class="nav-item pwa-visible">
            <%= link_to destroy_user_session_path, data: { turbo_method: :delete }, class: "nav-link d-flex align-items-center" do %>
              <%= image_tag "logout.png", style: "width: 23px; height: 23px;", class: "me-1 collapsed-size-20" %>
              Logout
            <% end %>
          </li>
        <% end %>
        <!---->
        <!---When user is signed-in and is a guest-->
        <% if user_signed_in? && current_user.guest? %>
          <li class="nav-item">
            <%= link_to rooms_path, class: "nav-link d-flex align-items-center" do %>
              <%= image_tag "rooms.png", style: "width: 20px; height: 20px;", class: "collapsed-size-16 rooms-icon" %>
              <%= t("navbar.rooms")%>
            <% end %>
          </li>
          <li class="nav-item">
            <%= link_to new_contact_message_path, class: "nav-link d-flex align-items-center" do %>
              <%= image_tag "contact.png", style: "width: 20px; height: 20px;", class: "collapsed-size-16 contact-icon" %>
              <%= t("navbar.contact_us")%>
            <% end %>
          </li>
          <li class="nav-item">
            <%= link_to about_us_path, class: "nav-link d-flex align-items-center" do %>
              <%= image_tag "about.png", style: "width: 25px; height: 25px;", class: "me-1 collapsed-size-20" %>
              <%= t("navbar.about_us")%>
            <% end %>
          </li>
          <li class="nav-item">
            <%= link_to faqs_path, class: "nav-link d-flex align-items-center" do %>
              <%= image_tag "faq.png", style: "width: 23px; height: 23px;", class: "me-1 collapsed-size-20" %>
              <%= t("navbar.faqs")%>
            <% end %>
          </li>
          <li class="nav-item">
            <%= link_to guest_path(current_user), class: "nav-link d-flex align-items-center" do %>
              <%= image_tag "guestDashboard.png", style: "width: 25px; height: 25px;", class: "me-1 collapsed-size-20" %>
              <%= t("navbar.dashboard")%>
            <% end %>
          </li>
          <li class="nav-item pwa-visible">
            <%= link_to destroy_user_session_path, data: { turbo_method: :delete }, class: "nav-link d-flex align-items-center" do %>
              <%= image_tag "logout.png", style: "width: 23px; height: 23px;", class: "me-1 collapsed-size-20" %>
              <%= t("navbar.logout")%>
            <% end %>
          </li>
        <% end %>
      <!-- Separator (Desktop) -->
        <li class="nav-item d-none d-lg-flex align-items-center">
            <div style="border-left: 1px solid rgba(0,0,0,0.1); height: 20px; margin: 0 10px;"></div>
        </li>
        <!-- Language Dropdown (Desktop) -->
        <li class="nav-item dropdown d-none d-lg-block">
          <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="navbarDropdownLang" role="button" data-bs-toggle="dropdown" aria-expanded="false">
             <i class="bi bi-globe me-1"></i>
             <%= I18n.locale.to_s.upcase %>
          </a>
          <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdownLang">
            <li><%= button_to "English", set_locale_path(locale: :en), method: :post, class: "dropdown-item #{'active' if I18n.locale == :en}" %></li>
            <li><%= button_to "日本語", set_locale_path(locale: :ja), method: :post, class: "dropdown-item #{'active' if I18n.locale == :ja}" %></li>
            <li><%= button_to "한국어", set_locale_path(locale: :ko), method: :post, class: "dropdown-item #{'active' if I18n.locale == :ko}" %></li>
            <li><%= button_to "中文", set_locale_path(locale: "zh-CN"), method: :post, class: "dropdown-item #{'active' if I18n.locale.to_s == 'zh-CN'}" %></li>
            <li><%= button_to "繁體中文", set_locale_path(locale: "zh-TW"), method: :post, class: "dropdown-item #{'active' if I18n.locale.to_s == 'zh-TW'}" %></li>
          </ul>
        </li>
      </ul>
    </div>
    <!-- Right: Login / Logout -->
    <ul class="navfoot navbar-nav browser-visible">

      <% if user_signed_in? %>
        <li class="nav-item">
          <%= link_to destroy_user_session_path, data: { turbo_method: :delete }, class: "nav-link d-flex align-items-center" do %>
            <%= image_tag "logout.png", style: "width: 23px; height: 23px;", class: "me-1 collapsed-size-20" %>
            <%= t("navbar.logout")%>
          <% end %>
        </li>
      <% else %>
        <li class="nav-item ">
          <%= link_to new_user_session_path, class: "nav-link d-flex align-items-center" do %>
            <%= image_tag "login.png", style: "width: 20px; height: 20px;", class: "collapsed-size-16 login-icon" %>
            <%= t("navbar.login")%>
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>
</div>
