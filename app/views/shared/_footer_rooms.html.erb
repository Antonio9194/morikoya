<div class="container-fluid d-flex justify-content-between align-items-center">
  <!-- Left: Logo -->
  <%= link_to root_path, class: "navbar-brand" do %>
    <%= image_tag "logo.png", style: "width: 140px; height:60px;" %>
  <% end %>
  <!-- Center: Nav Links -->
  <ul class=" navfoot navbar-nav d-flex flex-row gap-4">
    <% if user_signed_in? && current_user.admin? %>
      <li class="nav-item">
        <%= link_to rooms_path, class: "nav-link d-flex align-items-center" do %>
          <%= image_tag "rooms.png", style: "width: 20px; height: 20px;", class: "me-1" %>
          Rooms
        <% end %>
      </li>
      <li class="nav-item">
        <%= link_to admin_bookings_path, class: "nav-link d-flex align-items-center" do %>
          <%= image_tag "bookings.png", style: "width: 20px; height: 20px;", class: "me-1" %>
          Bookings
        <% end %>
      </li>
    <% else %>
      <li class="nav-item">
        <%= link_to rooms_path, class: "nav-link d-flex align-items-center" do %>
          <%= image_tag "rooms.png", style: "width: 20px; height: 20px;", class: "me-1" %>
          Rooms
        <% end %>
      </li>
      <li class="nav-item">
        <%= link_to new_contact_message_path, class: "nav-link d-flex align-items-center" do %>
          <%= image_tag "contact.png", style: "width: 20px; height: 20px;", class: "me-1" %>
          Contact Us
        <% end %>
      </li>
      <li class="nav-item">
        <%= link_to about_us_path, class: "nav-link d-flex align-items-center" do %>
          <%= image_tag "about.png", style: "width: 25px; height: 25px;", class: "me-1" %>
          About Us
        <% end %>
      </li>
      <li class="nav-item">
        <%= link_to faqs_path, class: "nav-link d-flex align-items-center" do %>
          <%= image_tag "faq.png", style: "width: 23px; height: 23px;", class: "me-1" %>
          FAQs
        <% end %>
      </li>
      <% if user_signed_in? && current_user.guest? %>
        <li class="nav-item">
          <%= link_to guest_path(current_user), class: "nav-link d-flex align-items-center" do %>
            <%= image_tag "guestDashboard.png", style: "width: 25px; height: 25px;", class: "me-1" %>
            Dashboard
          <% end %>
        </li>
      <% end %>
    <% end %>
    <!-- Right: Social -->
  </ul>
  <div class="d-flex flex-column align-items-start">
    <div class="d-flex align-items-center">
      <%= image_tag "telephone.png", style: "width: 20px; height: 20px;", class: "me-1" %>
      <p class="mb-0">(xxx) xxxx-xxxx</p>
    </div>
    <div class="d-flex align-items-center mt-2">
      <%= link_to "#", target: :_blank do %>
        <%= image_tag "instagram.png", style: "width: 20px; height: 20px;", class: "me-4" %>
      <% end %>
      <%= link_to "#", target: :_blank do %>
        <%= image_tag "x-logo.png", style: "width: 20px; height: 20px;" %>
      <% end %>
    </div>
  </div>
</div>
