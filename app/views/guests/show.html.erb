<div class="container my-5">
  <div class="row g-4">
    <!-- Messages  -->
    <div class="col-md-4">
      <div class="card shadow border-light rounded-4 h-100">
        <div class="card-body p-4">
          <h5 class="card-title mb-4">Messages</h5>
          <% if current_user.contact_messages.any? %>
            <div class="messages-list">
              <% current_user.contact_messages.each do |message| %>
                <div class="card mb-3 border-0 bg-light rounded-3">
                  <div class="card-body p-3">
                    <p class="mb-0"><%= message.message %></p>
                    <small class="text-muted"><%= message.created_at.strftime("%d %b, %Y") %></small>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="text-muted text-center py-4">No messages yet...</p>
          <% end %>
        </div>
      </div>
    </div>
    <!-- User Card + Avatar -->
    <div class="col-md-8">
      <div class="row g-3 mb-4">
        <!-- User Card -->
        <div class="col-md-9">
          <div class="card shadow border-light rounded-4 text-center h-100">
            <div class="card-body p-5">
              <h4 class="mb-2"><%= current_user.first_name %></h4>
              <p class="text-muted mb-0">Member since</p>
              <p class="text-muted"><%= current_user.created_at.strftime("%B %Y") %></p>
            </div>
          </div>
        </div>
        <!-- Avatar -->
        <div class="col-md-3">
          <div class="card shadow border-light rounded-4 overflow-hidden h-100">
            <div class="card-body p-3 d-flex flex-column align-items-center">
              <div class="rounded-circle bg-primary bg-opacity-10 d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                <h2 class="text-primary mb-0"><%= current_user.first_name.first.upcase %></h2>
              </div>
              <div class="w-100 border-top pt-3">
                <a href="#" class="d-block text-decoration-none text-dark py-2 px-3 rounded hover-bg-light" data-bs-toggle="modal" data-bs-target="#profileModal">
                  <i class="bi bi-person me-1"></i> Profile info
                </a>
                <a href="#" class="d-block text-decoration-none text-dark py-2 px-3 rounded hover-bg-light">
                  <i class="bi bi-receipt"></i> Billing History
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
      <!-- Bookings Section -->
      <div>
        <%
          confirmed_bookings = current_user.bookings.confirmed
          ongoing_bookings = confirmed_bookings.ongoing.order(start_date: :asc)
          past_bookings = confirmed_bookings.past.order(end_date: :desc)
          future_bookings = confirmed_bookings.future.order(start_date: :asc)
        %>
        <% if ongoing_bookings.any? || past_bookings.any? || future_bookings.any? %>
          <!-- Bootstrap Tabs Navigation -->
          <ul class="nav nav-tabs mb-4" id="bookingsTabs" role="tablist">
            <li class="nav-item" role="presentation">
              <button class="nav-link <%= 'active' if future_bookings.any? %>"
                      id="upcoming-tab"
                      data-bs-toggle="tab"
                      data-bs-target="#upcoming"
                      type="button"
                      role="tab"
                      aria-controls="upcoming"
                      aria-selected="<%= future_bookings.any? ? 'true' : 'false' %>">
                <i class="bi bi-calendar-event me-2"></i>
                Upcoming
                <% if future_bookings.any? %>
                  <span class="badge bg-info ms-2"><%= future_bookings.count %></span>
                <% end %>
              </button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link <%= 'active' if ongoing_bookings.any? && future_bookings.empty? %>"
                      id="current-tab"
                      data-bs-toggle="tab"
                      data-bs-target="#current"
                      type="button"
                      role="tab"
                      aria-controls="current"
                      aria-selected="<%= ongoing_bookings.any? && future_bookings.empty? ? 'true' : 'false' %>">
                <i class="bi bi-circle-fill text-success me-2" style="font-size: 0.6rem;"></i>
                Current
                <% if ongoing_bookings.any? %>
                  <span class="badge bg-success ms-2"><%= ongoing_bookings.count %></span>
                <% end %>
              </button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link <%= 'active' if past_bookings.any? && ongoing_bookings.empty? && future_bookings.empty? %>"
                      id="past-tab"
                      data-bs-toggle="tab"
                      data-bs-target="#past"
                      type="button"
                      role="tab"
                      aria-controls="past"
                      aria-selected="<%= past_bookings.any? && ongoing_bookings.empty? && future_bookings.empty? ? 'true' : 'false' %>">
                <i class="bi bi-clock-history me-2"></i>
                Past
                <% if past_bookings.any? %>
                  <span class="badge bg-secondary ms-2"><%= past_bookings.count %></span>
                <% end %>
              </button>
            </li>
          </ul>
          <!-- Tab Content -->
          <div class="tab-content" id="bookingsTabContent">
            <!-- Upcoming Bookings Tab -->
            <div class="tab-pane fade <%= 'show active' if future_bookings.any? %>"
                 id="upcoming"
                 role="tabpanel"
                 aria-labelledby="upcoming-tab">
              <% if future_bookings.any? %>
                <div class="row g-4">
                  <% future_bookings.each do |booking| %>
                    <div class="col-12 col-lg-6">
                      <div class="card shadow border-info border-2 rounded-4 h-100">
                        <div class="card-body p-4">
                          <h6 class="card-title mb-3"><%= booking.room.name %></h6>
                          <div class="mb-2">
                            <small class="text-muted d-block">Check-in</small>
                            <strong><%= booking.start_date.strftime("%d %b, %Y") %></strong>
                          </div>
                          <div class="mb-3">
                            <small class="text-muted d-block">Check-out</small>
                            <strong><%= booking.end_date.strftime("%d %b, %Y") %></strong>
                          </div>
                          <div class="d-flex justify-content-between align-items-center">
                            <span class="badge bg-info rounded-pill">
                              <i class="bi bi-check-circle me-1"></i> Upcoming
                            </span>
                            <span class="badge bg-<%= booking.payment_status == 'paid' ? 'success' : 'secondary' %> rounded-pill">
                              <%= booking.payment_status.capitalize %>
                            </span>
                          </div>
                        </div>
                      </div>
                    </div>
                  <% end %>
                </div>
              <% else %>
                <div class="card shadow-sm rounded-4">
                  <div class="card-body p-5 text-center">
                    <i class="bi bi-calendar-event text-muted mb-3" style="font-size: 3rem;"></i>
                    <p class="text-muted mb-0">No upcoming bookings...</p>
                    <%= link_to "Browse Rooms", rooms_path, class: "btn btn-primary mt-3" if defined?(rooms_path) %>
                  </div>
                </div>
              <% end %>
            </div>
            <!-- Current Bookings Tab -->
            <div class="tab-pane fade <%= 'show active' if ongoing_bookings.any? && future_bookings.empty? %>"
                 id="current"
                 role="tabpanel"
                 aria-labelledby="current-tab">
              <% if ongoing_bookings.any? %>
                <div class="row g-4">
                  <% ongoing_bookings.each do |booking| %>
                    <div class="col-12 col-lg-6">
                      <div class="card shadow border-success border-2 rounded-4 h-100">
                        <div class="card-body p-4">
                          <h6 class="card-title mb-3"><%= booking.room.name %></h6>
                          <div class="mb-2">
                            <small class="text-muted d-block">Check-in</small>
                            <strong><%= booking.start_date.strftime("%d %b, %Y") %></strong>
                          </div>
                          <div class="mb-3">
                            <small class="text-muted d-block">Check-out</small>
                            <strong><%= booking.end_date.strftime("%d %b, %Y") %></strong>
                          </div>
                          <div class="d-flex justify-content-between align-items-center">
                            <span class="badge bg-success rounded-pill">
                              <i class="bi bi-check-circle me-1"></i> Ongoing
                            </span>
                            <span class="badge bg-<%= booking.payment_status == 'paid' ? 'success' : 'secondary' %> rounded-pill">
                              <%= booking.payment_status.capitalize %>
                            </span>
                          </div>
                        </div>
                      </div>
                    </div>
                  <% end %>
                </div>
              <% else %>
                <div class="card shadow-sm rounded-4">
                  <div class="card-body p-5 text-center">
                    <i class="bi bi-circle text-muted mb-3" style="font-size: 3rem;"></i>
                    <p class="text-muted mb-0">No current stays...</p>
                  </div>
                </div>
              <% end %>
            </div>
            <!-- Past Bookings Tab -->
            <div class="tab-pane fade <%= 'show active' if past_bookings.any? && ongoing_bookings.empty? && future_bookings.empty? %>"
                 id="past"
                 role="tabpanel"
                 aria-labelledby="past-tab">
              <% if past_bookings.any? %>
                <div class="row g-4">
                  <% past_bookings.each do |booking| %>
                    <div class="col-12 col-lg-6">
                      <div class="card shadow border-light rounded-4 h-100">
                        <div class="card-body p-4">
                          <h6 class="card-title mb-3"><%= booking.room.name %></h6>
                          <div class="mb-2">
                            <small class="text-muted d-block">Check-in</small>
                            <strong><%= booking.start_date.strftime("%d %b, %Y") %></strong>
                          </div>
                          <div class="mb-3">
                            <small class="text-muted d-block">Check-out</small>
                            <strong><%= booking.end_date.strftime("%d %b, %Y") %></strong>
                          </div>
                          <div class="d-flex justify-content-between align-items-center">
                            <span class="badge bg-secondary rounded-pill">
                              <i class="bi bi-check2 me-1"></i> Completed
                            </span>
                            <span class="badge bg-<%= booking.payment_status == 'paid' ? 'success' : 'secondary' %> rounded-pill">
                              <%= booking.payment_status.capitalize %>
                            </span>
                          </div>
                        </div>
                      </div>
                    </div>
                  <% end %>
                </div>
              <% else %>
                <div class="card shadow-sm rounded-4">
                  <div class="card-body p-5 text-center">
                    <i class="bi bi-clock-history text-muted mb-3" style="font-size: 3rem;"></i>
                    <p class="text-muted mb-0">No past stays...</p>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% else %>
          <!-- No Confirmed Bookings -->
          <div class="card shadow-sm rounded-4">
            <div class="card-body p-5 text-center">
              <i class="bi bi-calendar-x text-muted mb-3" style="font-size: 3rem;"></i>
              <p class="text-muted mb-0">No confirmed bookings yet...</p>
              <%= link_to "Browse Rooms", rooms_path, class: "btn btn-primary mt-3" if defined?(rooms_path) %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
<!-- Profile Modal -->
<div class="modal fade"
     id="profileModal"
     tabindex="-1"
     aria-labelledby="profileModalLabel"
     aria-hidden="true"
     data-bs-backdrop="true"
     data-bs-keyboard="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content rounded-4">
      <div class="modal-header border-0 pb-0">
        <h5 class="modal-title" id="profileModalLabel">
          <i class="bi bi-person-circle me-2"></i>Profile Information
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4">
        <div id="profile_alerts"></div>
        <div id="profile_form">
          <%= render "guests/profile_form", user: current_user %>
        </div>
      </div>
    </div>
  </div>
</div>
