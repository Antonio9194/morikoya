<div class="booking-card card h-100">
  <div class="card-body">
    <h5 class="mb-3"><%= booking.room.name %></h5>
    <div class="mb-2">
      <small class="text-muted d-block">Check-in</small>
      <p class="h6 mb-0 fw-bold"><%= booking.start_date.strftime("%d %b, %Y") %></p>
    </div>
    <div class="mb-4">
      <small class="text-muted d-block">Check-out</small>
      <p class="h6 mb-0 fw-bold"><%= booking.end_date.strftime("%d %b, %Y") %></p>
    </div>
    <div class="d-flex justify-content-between align-items-center mt-auto">
      <span class="badge bg-light text-dark border">
        <i class="bi bi-<%= icon %> me-1"></i> <%= status_text %>
      </span>
      <span class="badge <%= booking.payment_status == 'paid' ? 'bg-success' : 'bg-secondary' %>">
        <%= booking.payment_status.capitalize %>
      </span>
    </div>
  </div>
</div>
