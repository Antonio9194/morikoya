<div class="booking-card card mb-3">
  <div class="card-body p-4">
    <div class="row align-items-center">
      <!-- Room Name -->
      <div class="col-lg-4 mb-3 mb-lg-0">
        <h5 class="mb-0"><%= booking.room.name %></h5>
      </div>
      <!-- Dates -->
      <div class="col-lg-4 booking-dates mb-3 mb-lg-0">
        <div class="d-flex justify-content-around text-center">
          <div>
            <small class="text-muted d-block text-uppercase" style="font-size: 0.75rem;"><%= t("dashboard.checkin") %></small>
            <span class="fw-bold"><%= l(booking.start_date, format: :short) %></span>
            <small class="text-muted d-block"><%= l(booking.end_date, format: :year) %></small>
          </div>
          <div>
            <small class="text-muted d-block text-uppercase" style="font-size: 0.75rem;"><%= t("dashboard.checkout") %></small>
            <span class="fw-bold"><%= l(booking.end_date, format: :short) %></span>
            <small class="text-muted d-block"><%= l(booking.end_date, format: :year) %></small>
          </div>
        </div>
      </div>
      <!-- Action/Status -->
      <div class="col-lg-4 booking-actions">
        <div class="d-flex flex-column align-items-lg-end align-items-start gap-2">
          <span class="badge rounded-pill <%= booking.payment_status == 'paid' ? 'bg-success-subtle text-success' : 'bg-warning-subtle text-warning' %>">
            <i class="bi bi-<%= icon %> me-1"></i> <%= status_text %>
          </span>
          <% if booking.payment_status == 'paid' %>
            <span class="badge bg-light text-muted border"><%= t("payment_status.paid") %></span>
          <% else %>
            <span class="badge bg-light text-muted border"><%= t("payment_status.failed") %></span>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
