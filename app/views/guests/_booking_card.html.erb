<div class="bookingcard card shadow border-light rounded-4 h-100">
  <div class=" card-body p-4">
    <h6 class="card-title mb-3"><%= booking.room.name %></h6>
    <div class="mb-2">
      <small class="text-muted d-block"><%= t("dashboard.checkin") %></small>
      <strong><%= l(booking.start_date, format: :long) %></strong>
    </div>
    <div class="mb-3">
      <small class="text-muted d-block"><%= t("dashboard.checkout") %></small>
      <strong><%= l(booking.end_date, format: :long)%></strong>
    </div>
    <div class="d-flex justify-content-between align-items-center">
      <span class="badge rounded-pill">
        <i class="bi bi-<%= icon %> me-1"></i> <%= status_text %>
      </span>
      <span class="badge bg-<%= booking.payment_status == 'paid' ? 'success' : 'secondary' %> rounded-pill">
        <%= t("payment_status.#{booking.payment_status}") %>
      </span>
    </div>
  </div>
</div>
