<%
  confirmed_bookings = user.bookings.confirmed
  ongoing_bookings = confirmed_bookings.ongoing.order(start_date: :asc)
  past_bookings = confirmed_bookings.past.order(end_date: :desc)
  future_bookings = confirmed_bookings.future.order(start_date: :asc)
%>
<% if ongoing_bookings.any? || past_bookings.any? || future_bookings.any? %>
  <!-- Bootstrap Tabs Navigation -->
  <ul class="nav nav-tabs mb-4" id="bookingsTabs" role="tablist">
    <li class="nav-item" role="presentation">
      <button class="menutabs nav-link <%= 'active' if future_bookings.any? %>"
              id="upcoming-tab"
              data-bs-toggle="tab"
              data-bs-target="#upcoming"
              type="button"
              role="tab"
              aria-controls="upcoming"
              aria-selected="<%= future_bookings.any? ? 'true' : 'false' %>">
        <i class="bi bi-calendar-event me-2"></i>
        Upcoming
        <% if future_bookings.any? %>
          <span class="badge ms-2"><%= future_bookings.count %></span>
        <% end %>
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="menutabs nav-link <%= 'active' if ongoing_bookings.any? && future_bookings.empty? %>"
              id="current-tab"
              data-bs-toggle="tab"
              data-bs-target="#current"
              type="button"
              role="tab"
              aria-controls="current"
              aria-selected="<%= ongoing_bookings.any? && future_bookings.empty? ? 'true' : 'false' %>">
        <i class="bi bi-circle-fill text-success me-2" style="font-size: 0.6rem;"></i>
        Current
        <% if ongoing_bookings.any? %>
          <span class="badge ms-2"><%= ongoing_bookings.count %></span>
        <% end %>
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="menutabs nav-link <%= 'active' if past_bookings.any? && ongoing_bookings.empty? && future_bookings.empty? %>"
              id="past-tab"
              data-bs-toggle="tab"
              data-bs-target="#past"
              type="button"
              role="tab"
              aria-controls="past"
              aria-selected="<%= past_bookings.any? && ongoing_bookings.empty? && future_bookings.empty? ? 'true' : 'false' %>">
        <i class="bi bi-clock-history me-2"></i>
        Past
        <% if past_bookings.any? %>
          <span class="badge ms-2"><%= past_bookings.count %></span>
        <% end %>
      </button>
    </li>
  </ul>
  <!-- Tab Content -->
  <div class="tab-content" id="bookingsTabContent">
    <%= render "guests/bookings_tab",
               tab_id: "upcoming",
               bookings: future_bookings,
               is_active: future_bookings.any?,
               border_color: "info",
               badge_color: "info",
               icon: "check-circle",
               status_text: "Upcoming",
               empty_icon: "calendar-event",
               empty_message: "No upcoming bookings...",
               show_browse_button: true %>
    <%= render "guests/bookings_tab",
               tab_id: "current",
               bookings: ongoing_bookings,
               is_active: ongoing_bookings.any? && future_bookings.empty?,
               border_color: "success",
               badge_color: "success",
               icon: "check-circle",
               status_text: "Ongoing",
               empty_icon: "circle",
               empty_message: "No current stays...",
               show_browse_button: false %>
    <%= render "guests/bookings_tab",
               tab_id: "past",
               bookings: past_bookings,
               is_active: past_bookings.any? && ongoing_bookings.empty? && future_bookings.empty?,
               border_color: "light",
               badge_color: "secondary",
               icon: "check2",
               status_text: "Completed",
               empty_icon: "clock-history",
               empty_message: "No past stays...",
               show_browse_button: false %>
  </div>
<% else %>
  <!-- No Confirmed Bookings -->
  <div class="bookingscard card shadow border-light rounded-4">
    <div class="card-body p-5 text-center">
      <i class="bi bi-calendar-x text-muted mb-3" style="font-size: 3rem;"></i>
      <p class="text-muted mb-0">No confirmed bookings yet...</p>
      <%= link_to "Browse Rooms", rooms_path, class: "browserooms btn btn-primary mt-3" if defined?(rooms_path) %>
    </div>
  </div>
<% end %>
