<div class="modal fade"
     id="billingModal"
     tabindex="-1"
     aria-labelledby="billingModalLabel"
     aria-hidden="true"
     data-bs-backdrop="true"
     data-bs-keyboard="true">
  <div class="modal-dialog modal-dialog-centered modal-xl">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="billingModalLabel">
          <i class="bi bi-receipt me-2"></i>
          <%= t("dashboard.billing") %>
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <% paid_bookings = user.bookings.where(payment_status: 'paid').order(created_at: :desc) %>
        <% if paid_bookings.any? %>
          <div class="table-responsive">
            <table class="table table-hover align-middle">
              <thead class="table-light">
                <tr>
                  <th scope="col"><%= t("dashboard.transaction_id") %></th>
                  <th scope="col"><%= t("dashboard.room") %></th>
                  <th scope="col"><%= t("dashboard.issue_date") %></th>
                  <th scope="col"><%= t("dashboard.amount") %></th>
                  <th scope="col"><%= t("dashboard.billing_status") %></th>
                  <th scope="col"><%= t("dashboard.receipt") %></th>
                </tr>
              </thead>
              <tbody>
                <% paid_bookings.each do |booking| %>
                  <tr>
                    <td>
                      <small class="text-muted font-monospace">
                        <%= booking.stripe_payment_intent_id ? booking.stripe_payment_intent_id.truncate(20) : "N/A" %>
                      </small>
                    </td>
                    <td>
                      <strong><%= booking.room.name %></strong>
                      <br>
                      <small class="text-muted">
                        <%= l(booking.start_date, format: :short) %> - <%= l(booking.end_date, format: :long_inverted) %>
                      </small>
                    </td>
                    <td><%= l(booking.created_at, format: :long_inverted) %></td>
                    <td>
                      <strong>¥<%= number_with_delimiter(booking.total_price_cents) %></strong>
                    </td>
                    <td>
                      <span class="badge">
                        <i class="bi bi-check-circle me-1"></i>
                        <%= t("payment_status.#{booking.payment_status}") %>
                      </span>
                    </td>
                    <td>
                      <% if booking.stripe_receipt_url %>
                        <%= link_to booking.stripe_receipt_url, target: "_blank", class: "download btn btn-sm " do %>
                          <i class="bi bi-download me-1"></i>
                          <%= t("dashboard.download") %>
                        <% end %>
                      <% else %>
                        <span class="text-muted small">N/A</span>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
          <div class="mt-4 p-3 bg-light rounded">
            <div class="d-flex justify-content-between align-items-center">
              <span class="text-muted"><%= t("dashboard.total") %></span>
              <strong class="fs-5">¥<%= number_with_delimiter(paid_bookings.sum(:total_price_cents)) %></strong>
            </div>
          </div>
        <% else %>
          <div class="text-center py-5">
            <i class="bi bi-receipt text-muted mb-3" style="font-size: 3rem;"></i>
            <p class="text-muted mb-0"><%= t("dashboard.nomoney") %></p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
