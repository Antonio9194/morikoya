<%= simple_form_for user, url: guest_path(user), method: :patch do |f| %>
  <%= f.error_notification %>
  <%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present? %>
  <!-- First Name (Read-only) -->
  <div class="mb-3">
    <%= f.label :first_name, t("dashboard.info3"), class: "form-label text-muted small" %>
    <div class="form-control bg-light" style="cursor: not-allowed;">
      <%= user.first_name %>
    </div>
  </div>
  <!-- Last Name (Read-only) -->
  <div class="mb-3">
    <%= f.label :last_name, t("dashboard.info4"), class: "form-label text-muted small" %>
    <div class="form-control bg-light" style="cursor: not-allowed;">
      <%= user.last_name %>
    </div>
  </div>
  <%= f.input :email,
              label: t("dashboard.info5"),
              label_html: { class: "form-label text-muted small" },
              input_html: { class: "form-control", placeholder: "your@email.com" },
              hint: (content_tag(:i, "", class: "bi bi-info-circle me-1") + t("dashboard.note1")).html_safe,
              wrapper_html: { class: "mb-3" } %>
  <%= f.input :phone_number,
              label: t("dashboard.info6"),
              label_html: { class: "form-label text-muted small" },
              input_html: { class: "form-control", placeholder: "+81 90-1234-5678" },
              hint: (content_tag(:i, "", class: "bi bi-info-circle me-1") + t("dashboard.note2")).html_safe,
              wrapper_html: { class: "mb-4" } %>
  <div class="d-grid gap-2">
    <%= f.button :submit, t("dashboard.update"), class: " updateprofile btn btn-primary" %>
  </div>
<% end %>
