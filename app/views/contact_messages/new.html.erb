<div class="contactus">
  <div>
    <% if current_user.present? %>
      <h4> Welcome back <%= current_user.first_name %>!</h4>
    <% else %>
    <% end %>
  </div>
  <div class="contact-form">
    <%= simple_form_for @contact_message do |f| %>
      <%= f.input :name, label: "Full Name", input_html: { value: current_user&.first_name } %>
      <%= f.input :email, label: "Email", input_html: { value: current_user&.email } %>
      <%= f.input :message, as: :text, label: "Message" %>
      <%= f.button :submit, "Send" %>
    <% end %>
  </div>
  <div class="map">
    <div style="width: 100%; height: 600px;"
      data-controller="map"
      data-map-marker-value='{"lat": 35.715929690607304, "lng": 139.7913157845523}'
      data-map-api-key-value="<%= ENV.fetch('MAPBOX_API_KEY') %>"></div>
  </div>
</div>
