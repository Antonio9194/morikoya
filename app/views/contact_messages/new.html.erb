<div class="container d-flex align-items-center" style="min-height: calc(100vh - 120px);">
  <div class="row justify-content-between align-items-center gx-5 gy-3 w-100">
    <div class="contactus col-sm-12 col-md-6 col-lg-6">
      <% if current_user.present? %>
        <h5 class="welcome-text"> Welcome back <%= current_user.first_name %>!</h5>
      <% else %>
        <h5 class="welcome-text"> Leave us a message!</h5>
      <% end %>
      <div class="contact-form">
        <%= simple_form_for @contact_message do |f| %>
          <%= f.input :name, label: "Full Name", input_html: { value: current_user&.first_name } %>
          <%= f.input :email, label: "Email", input_html: { value: current_user&.email } %>
          <%= f.input :message, as: :text, label: "Message" %>
          <%= f.button :submit, "Send" %>
        <% end %>
      </div>
    </div>
    <div class="col-sm-12 col-md-6 col-lg-6">
      <%= render "pages/map" %>
    </div>
  </div>
</div>
