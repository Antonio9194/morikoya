<!-- app/views/payments/new.html.erb -->
<div class="container my-5 payment-page">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <!-- Payment Card -->
      <div class="payment-card card"
           data-controller="stripe-payment"
           data-stripe-payment-publishable-key-value="<%= Rails.configuration.stripe[:publishable_key] %>"
           data-stripe-payment-booking-id-value="<%= @booking.id %>">
        <!-- Card Header -->
        <div class="card-header payment-header">
          <h3 class="mb-0 text-center">
            <%=
            t("payment.complete") %>
          </h3>
        </div>
        <!-- Card Body -->
        <div class="card-body p-5">
          <!-- Booking Summary Section -->
          <div class="booking-summary-section mb-5">
            <h5 class="section-title text-center mb-4">
              <%= t("payment.summary") %>
            </h5>
            <div class="summary-row">
              <span class="label"><%= t("payment.info1") %></span>
              <span class="value"><%= @booking.room.name %></span>
            </div>
            <div class="summary-row">
              <span class="label"><%= t("payment.info2") %></span>
              <span class="value"><%= l(@booking.start_date, format: :long) %></span>
            </div>
            <div class="summary-row">
              <span class="label"><%= t("payment.info3") %></span>
              <span class="value"><%= l(@booking.end_date, format: :long) %></span>
            </div>
            <div class="summary-row">
              <span class="label"><%= t("payment.info4") %></span>
              <span class="value"><%= @booking.number_of_nights %> <%= t("payment.info10") %></span>
            </div>
            <div class="summary-row">
              <span class="label"><%= t("payment.info5") %></span>
              <span class="value">¥<%= number_with_delimiter(@booking.room.price_per_night) %></span>
            </div>
            <div class="summary-row total-row">
              <span class="label h5 mb-0"><%= t("payment.info6") %></span>
              <span class="value h4 mb-0 text-danger">¥<%= number_with_delimiter(@booking.total_price_cents) %></span>
            </div>
          </div>
          <!-- Stripe Element -->
          <form id="payment-form" action="<%= payments_path %>" data-stripe-payment-target="form">
            <div id="payment-element" class="mb-5" data-stripe-payment-target="cardElement">
              <!-- Stipe.js will inject the Payment Element here -->
            </div>
            <div id="payment-message" class="hidden text-danger text-center mb-4" data-stripe-payment-target="cardErrors"></div>
            <button id="submit" class="payment-submit-btn btn w-100"
                    data-stripe-payment-target="submitButton"
                    data-action="click->stripe-payment#handleSubmit">
              <div class="spinner-border spinner-border-sm d-none me-2" role="status" data-stripe-payment-target="spinner">
                <span class="visually-hidden">Loading...</span>
              </div>
              <span id="button-text" data-stripe-payment-target="buttonText"><%= t("payment.pay") %></span>
            </button>
          </form>
          <!-- Cancel Link -->
          <div class="text-center mt-3">
            <%= link_to cancel_booking_path(@booking),
              data: {
                turbo_method: :patch,
                turbo_confirm: "Are you sure you want to cancel this booking?"
              },
              class: "text-muted text-decoration-none small" do %>
              <%= t("payment.return") %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
