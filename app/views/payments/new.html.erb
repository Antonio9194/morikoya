<!-- app/views/payments/new.html.erb -->
<div class="container-fluid payment-page-wrapper" style="margin-top: 3rem; margin-bottom: 2rem">
  <div class="row justify-content-center">
    <div class="col-lg-12">
      <!-- Payment Card -->
      <div class="paymentcontainer card shadow-sm"
           data-controller="stripe-payment"
           data-stripe-payment-publishable-key-value="<%= Rails.configuration.stripe[:publishable_key] %>"
           data-stripe-payment-booking-id-value="<%= @booking.id %>">
        <!-- Card Header -->
        <div class="paymentcard card-header bg-primary text-white">
          <h3 class="mb-0">
            <i class="fas fa-credit-card me-2"></i>
            <%= t("payment.complete") %>
          </h3>
        </div>
        <!-- Card Body -->
        <div class="card-body p-4">
          <!-- Booking Summary Section -->
          <div class="bookingsummary alert-light border">
            <h5 class="alert-heading mb-3">
              <i class="fas fa-receipt me-2"></i>
              <%= t("payment.summary") %>
            </h5>
            <div class="row mb-2">
              <div class="col-sm-5 text-muted"><%= t("payment.info1") %></div>
              <div class="col-sm-7 fw-bold"><%= @booking.room.name %></div>
            </div>
            <div class="row mb-2">
              <div class="col-sm-5 text-muted"><%= t("payment.info2") %></div>
              <div class="col-sm-7"><%= l @booking.start_date, format: :long %></div>
            </div>
            <div class="row mb-2">
              <div class="col-sm-5 text-muted"><%= t("payment.info3") %></div>
              <div class="col-sm-7"><%= l @booking.end_date, format: :long %></div>
            </div>
            <div class="row mb-2">
              <div class="col-sm-5 text-muted"><%= t("payment.info4") %></div>
              <div class="col-sm-7"><%= @booking.number_of_nights %> <%= t("payment.info10") %></div>
            </div>
            <div class="row mb-2">
              <div class="col-sm-5 text-muted"><%= t("payment.info5") %></div>
              <div class="col-sm-7">¥<%= number_with_delimiter(@booking.room.price_per_night) %></div>
            </div>
            <hr class="my-3">
            <div class="row">
              <div class="col-sm-5">
                <h5 class="mb-0"><%= t("payment.info6") %></h5>
              </div>
              <div class="col-sm-7">
                <h5 class="text-primary mb-0">
                  ¥<%= number_with_delimiter(@booking.total_price_cents) %>
                </h5>
              </div>
            </div>
          </div>
          <!-- Payment Form -->
          <%= simple_form_for :payment,
                              url: payments_path(booking_id: @booking.id),
                              html: {
                                data: {
                                  stripe_payment_target: "form",
                                  action: "submit->stripe-payment#handleSubmit"
                                }
                              } do |f| %>
            <!-- Card Element Container -->
            <div class="mb-4">
              <%= f.label :card_information, class: "form-label fw-bold" do %>
                <i class="fas fa-credit-card me-2"></i>
                <%= t("payment.info7") %>
              <% end %>
              <!-- Stripe Elements will mount here -->
              <div id="card-element"
                   class="form-control p-3"
                   data-stripe-payment-target="cardElement"
                   style="height: 50px;">
              </div>
              <!-- Error messages will appear here -->
              <div class="text-danger mt-2"
                   data-stripe-payment-target="cardErrors"
                   role="alert">
              </div>
            </div>
            <!-- Submit Button -->
            <div class="d-grid mb-3">
              <%= f.button :button,
                           type: "submit",
                           class: "paymentsubmit btn btn-primary btn-lg",
                           data: { stripe_payment_target: "submitButton" } do %>
                <span data-stripe-payment-target="buttonText">
                  <i class="fas fa-lock me-2"></i>
                  <%= t("payment.info8") %>
                  <%= number_with_delimiter(@booking.total_price_cents) %>
                </span>
                <span class="spinner-border spinner-border-sm ms-2 d-none"
                      data-stripe-payment-target="spinner">
                </span>
              <% end %>
            </div>
          <% end %>
          <!-- Security Message -->
          <div class="text-center text-muted">
            <small>
              <i class="fas fa-shield-alt me-1"></i>
              <%= t("payment.info9") %>
            </small>
          </div>
          <!-- Cancel Link -->
          <div class="text-center mt-3">
            <%= link_to cancel_booking_path(@booking),
              data: {
                turbo_method: :patch,
                turbo_confirm: "Cancel this booking?"
              },
              class: "btn btn-link text-muted" do %>
              <i class="fas fa-arrow-left me-1"></i>
              <%= t("payment.return") %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
