<div class="auth-page">
  <div class="auth-card">
    <div class="auth-header">
      <h2>Forgot your password?</h2>
      <p>Enter your email and we'll send you reset instructions.</p>
    </div>

    <%= simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "auth-form" }) do |f| %>
      <%= f.error_notification %>

      <div class="form-inputs mb-4">
        <%= f.input :email,
                    required: true,
                    autofocus: true,
                    input_html: { autocomplete: "email", class: "form-control" },
                    label_html: { class: "form-label" } %>
      </div>

      <div class="form-actions">
        <%= f.button :submit, "Send Instructions", class: "btn auth-btn" %>
      </div>
    <% end %>

    <div class="auth-links">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
