<div class="auth-page">
  <div class="auth-card">
    <div class="auth-header">
      <h2><%= t("password.forgot") %></h2>
      <p><%= t("password.info") %></p>
    </div>
    <%= simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "auth-form" }) do |f| %>
      <%= f.error_notification %>
      <div class="form-inputs mb-4">
        <%= f.input :email,
                    required: true,
                    autofocus: true,
                    label: t("password.email"),
                    input_html: { autocomplete: "email", class: "form-control" },
                    label_html: { class: "form-label" } %>
      </div>
      <div class="form-actions">
        <%= f.button :submit, t("password.reset"), class: "btn auth-btn" %>
      </div>
    <% end %>
    <div class="auth-links">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
