<div class="auth-page">
  <div class="auth-card">
    <div class="auth-header">
      <h2><%= t("login.header") %></h2>
      <p><%= t("login.header1") %></p>
    </div>
    <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "auth-form" }) do |f| %>
      <div class="form-inputs">
        <%= f.input :email,
                    required: false,
                    autofocus: true,
                    label: t("login.email"),
                    input_html: { autocomplete: "email" } %>
        <%= f.input :password,
                    required: false,
                    label: t("login.password"),
                    input_html: { autocomplete: "current-password" } %>
        <%= f.input :remember_me, as: :boolean, label: t("login.remember") if devise_mapping.rememberable? %>
      </div>
      <div class="form-actions mt-4">
        <%= f.button :submit, t("login.submit"), class: "btn auth-btn" %>
      </div>
    <% end %>
    <div class="auth-links">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
