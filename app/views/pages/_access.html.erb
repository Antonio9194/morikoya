<h3><%= t("access.title") %></h3>
<div class="access-block">
  <div class="subway-background">
    <p class="aboutus-description">
      <%= t("access.description") %>
    </p>
    <div class="subway-block">
  <div class="subway-block">
  <% I18n.t("access.subway", default: []).each do |station| %>
    <h4><%= station[:station] %></h4>
    <h5><%= station[:info] %></h5>
    <hr>
  <% end %>
</div>
  </div>
  <div class="airport-background">
    <div class="airport-block" style="margin-top: 20px;">
      <h4><%= t("access.airport.title") %></h4>
      <h5><%= t("access.airport.haneda") %></h5>
      <h5><%= t("access.airport.narita") %></h5>
      <hr>
    </div>
  </div>
  <div class="bus-background">
    <div class="bus-block" style="margin-top: 20px;">
      <h4><%= t("access.bus.title") %></h4>
      <h5><%= t("access.bus.info1") %></h5>
      <h5><%= t("access.bus.info2") %></h5>
      <hr>
    </div>
  </div>
  <div class="sightseeing-background">
    <div class="sightseeing-block" style="margin-top: 20px;">
      <h4><%= t("access.sightseeing.title") %></h4>
      <h5><%= t("access.sightseeing.info1") %></h5>
      <h5><%= t("access.sightseeing.info2") %></h5>
      <h5><%= t("access.sightseeing.info3") %></h5>
      <hr>
    </div>
  </div>
  <div class="taxi-background">
    <div class="taxi-block" style="margin-top: 20px;">
      <h4><%= t("access.taxi.title") %></h4>
      <h5><%= t("access.taxi.info1") %></h5>
      <h5><%= t("access.taxi.info2") %></h5>
    </div>
  </div>
</div>
