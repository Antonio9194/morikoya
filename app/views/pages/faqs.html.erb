<%= video_tag "background.mp4", autoplay: true, loop: true, muted: true, playsinline: true, class: "background-video" %>
<div class="container-fluid faq-page-wrapper" style="margin-top: 3rem; margin-bottom: 2rem">
  <div class="navigation-faq">
    <%= render "pages/navfaq" %>
  </div>
  
    <!--Reservation & Check-in-->
    <div id="reservation" class="faqbody" data-controller="faq">
      <%= render "pages/reservationsfaq" %>
    </div>
    <!--Rooms & Amenities-->
    <div id="roomamenities" class="faqbody" data-controller="faq">
      <%= render "pages/roomandamenities" %>
    </div>
    <!--Facilities-->
    <div id="facilities" class="faqbody" data-controller="faq">
      <%= render "pages/facilities" %>
    </div>
    <!--Policies-->
    <div id="policies" class="faqbody" data-controller="faq">
      <%= render "pages/policies" %>
    </div>
    <!--Access & Location-->
    <div id="accesslocation" class="faqbody" data-controller="faq">
      <%= render "pages/accessandlocation" %>
    </div>
</div>
<footer>
  <%= render "shared/footer_rooms" %>
</footer>
