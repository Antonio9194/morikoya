<%= video_tag "background.mp4", autoplay: true, loop: true, muted: true, playsinline: true, class: "background-video" %>

<div class="faqcontainer">
  <div class="faqbody">
    <div>
      <div>
        <h3>Reservation & Check in</h3>
      </div>

      <div class="faqquestion">
        <h5>What are the check-in and check-out times?</h5>
        <h5 class="plus">+</h5>
      </div>
      <div class="faqanswer ">
        <h6>Check in starts at 15:00 and Check out is at 11:00.</h6>
      </div>

      <hr>

      <div class="faqquestion">
        <h5>Can I request early check-in or early-check-out?</h5>
        <h5 class="plus">+</h5>
      </div>
      <div class="faqanswer d-none">
        <h6>Early check-in depends on availability; if possible, we will be happy to accommodate it for you.</h6>
        <h6>Early check-out is always available.</h6>
      </div>

      <hr>

      <div class="faqquestion">
        <h5>Do you accept walk-in reservations?</h5>
        <h5 class="plus">+</h5>
      </div>
      <div class="faqanswer d-none">
        <h6>Walk-ins are accepted depending on room availability on the same day.</h6>
      </div>

      <hr>

      <div class="faqquestion">
        <h5>What is your cancellation policy?</h5>
        <h5 class="plus">+</h5>
      </div>
      <div>
        <h6 class="faqanswer d-none">Cancellations are free until a certain period before arrival. After that, charges may apply.</h6>
      </div>

      <hr>

      <div class="faqquestion">
        <h5>What payment methods do you accept?</h5>
        <h5 class="plus">+</h5>
      </div>
      <div>
        <h6 class="faqanswer d-none">We accept major credit cards, cash, and selected digital payment methods.</h6>
      </div>

      <hr>

      <div class="faqquestion">
        <h5>Is there a deposit required?</h5>
        <h5 class="plus">+</h5>
      </div>
      <div>
        <h6 class="faqanswer d-none">No deposit is required.</h6>
      </div>
    </div>

    <hr>

    <div>
      <div>
        <h3>Rooms & Amenities</h3>
      </div>

      <div class="faqquestion">
        <h5>What amenities are included?</h5>
        <h5 class="plus">+</h5>
      </div>
      <div>
        <h6 class="faqanswer d-none">Bathroom amenities including towels, shampoo, body wash, and more are provided. 
        For specifics, feel free to check the <%= link_to "rooms", rooms_path %>.</h6>
      </div>

      <hr>

      <div class="faqquestion">
        <h5>Is Wi-Fi available?</h5>
        <h5 class="plus">+</h5>
      </div>
      <div>
        <h6 class="faqanswer d-none">Yes, free high-speed Wi-Fi is available throughout the hotel.</h6>
      </div>

      <hr>

      <div class="faqquestion">
        <h5>Are toiletries replenished daily?</h5>
        <h5 class="plus">+</h5>
      </div>
      <div>
        <h6 class="faqanswer d-none">Yes, housekeeping will replenish them during your stay.</h6>
      </div>
    </div>

    <hr>

    <div>
      <div>
        <h3>Facilities</h3>
      </div>

      <div class="faqquestion">
        <h5>Do you have a laundry area?</h5>
        <h5 class="plus">+</h5>
      </div>
      <div>
        <h6 class="faqanswer d-none">Yes, every apartment has a washer-dryer.</h6>
      </div>

      <hr>

      <div class="faqquestion">
        <h5>Is luggage storage available?</h5>
        <h5 class="plus">+</h5>
      </div>
      <div>
        <h6 class="faqanswer d-none">Luggage storage is available before check-in and after check-out.</h6>
      </div>

      <hr>

      <div class="faqquestion">
        <h5>Do you have parking?</h5>
        <h5 class="plus">+</h5>
      </div>
      <div>
        <h6 class="faqanswer d-none">We do not have private parking, but nearby paid parking options are available.</h6>
      </div>
    </div>

    <hr>

    <div>
      <div>
        <h3>Policies</h3>
      </div>

      <div class="faqquestion">
        <h5>Are pets allowed?</h5>
        <h5 class="plus">+</h5>
      </div>
      <div>
        <h6 class="faqanswer d-none">Unfortunately, pets are not allowed.</h6>
      </div>

      <hr>

      <div class="faqquestion">
        <h5>Is smoking permitted?</h5>
        <h5 class="plus">+</h5>
      </div>
      <div>
        <h6 class="faqanswer d-none">The hotel is fully non-smoking.</h6>
      </div>

      <hr>

      <div class="faqquestion">
        <h5>Do you allow children?</h5>
        <h5 class="plus">+</h5>
      </div>
      <div>
        <h6 class="faqanswer d-none">Children are welcome.</h6>
      </div>
    </div>

    <hr>

    <div>
      <div>
        <h3>Access & Location</h3>
      </div>

      <div class="faqquestion">
        <h5>How do I get to the hotel?</h5>
        <h5 class="plus">+</h5>
      </div>
      <div>
        <h6 class="faqanswer d-none">We are located near Asakusa Station, with easy access via subway and bus.
        Please refer to our <%= link_to "map", new_contact_message_path %>.</h6>
      </div>

      <hr>

      <div class="faqquestion">
        <h5>Do you offer airport pickup?</h5>
        <h5 class="plus">+</h5>
      </div>
      <div>
        <h6 class="faqanswer d-none">Airport pickup is not provided, but we can guide you on the best route.</h6>
      </div>

      <hr>

    </div>
  </div>
</div>