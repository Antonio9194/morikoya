<div class="modal fade" id="deleteBookingModal-<%= booking.id %>" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="deletebookinginfocontent modal-content">
      <div class="deletebookinginfoheader modal-header">
        <p class="modal-title">Confirm Delete</p>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="deletebookinginfo modal-body">
        <p>Are you sure you want to cancel this reservation?</p>
      </div>
      <div class="deletebookingfoot modal-footer">
        <button type="button" class="closerbutton btn" data-bs-dismiss="modal">Close</button>
        <%= button_to "Confirm", admin_booking_path(booking), method: :delete, class: "deletebutton btn" %>
      </div>
    </div>
  </div>
</div>
