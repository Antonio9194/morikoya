<!-- app/views/bookings/confirmation.html.erb -->
<div class="container-fluid confirmation-page-wrapper" style="margin-top: 3rem; margin-bottom: 2rem">
  <div class="row justify-content-center">
    <div class="col-md-12">
      <!-- Success Card -->
      <div class="paymentsuccess card shadow ">
        <div class="card-header text-center py-4">
          <h2 class="mb-0">
            <i class="fas fa-check-circle fa-2x mb-3"></i>
            <br>
            <%= t("booking_confirmation.heading") %>
            <h2>
            </div>
            <div class="card-body p-4">
              <!-- Success Message -->
              <div class="bookingconfirmed alert-success">
                <h4>
                  <%= t("booking_confirmation.info1") %>
                </h4>
                <p class="mb-0">
                  <%= t("booking_confirmation.info2") %>
                </p>
              </div>
              <!-- Booking Details -->
              <h4 class="mt-4 mb-3"><%= t("booking_confirmation.info3") %></h4>
              <hr>
              <div class="row mb-2">
                <div class="col-6"><strong><%= t("booking_confirmation.info4") %></strong></div>
                <div class="col-6">#<%= @booking.id %></div>
              </div>
              <div class="row mb-2">
                <div class="col-6"><strong><%= t("booking_confirmation.info5") %></strong></div>
                <div class="col-6"><%= @booking.room.name %></div>
              </div>
              <div class="row mb-2">
                <div class="col-6"><strong><%= t("booking_confirmation.info6") %></strong></div>
                <div class="col-6"><%= l(@booking.start_date, format: :long) %></div>
              </div>
              <div class="row mb-2">
                <div class="col-6"><strong><%= t("booking_confirmation.info7") %></strong></div>
                <div class="col-6"><%= l(@booking.end_date, format: :long) %></div>
              </div>
              <div class="row mb-2">
                <div class="col-6"><strong><%= t("booking_confirmation.info8") %></strong></div>
                <div class="col-6"><%= @booking.number_of_nights %></div>
              </div>
              <div class="row mb-2">
                <div class="col-6"><strong><%= t("booking_confirmation.info9") %></strong></div>
                <div class="col-6">
                  <h6 class="paymenttotal mb-0">¥<%= number_with_delimiter(@booking.total_price_cents) %></h6>
                </div>
              </div>
              <div class="row mb-2">
                <div class="col-6"><strong><%= t("booking_confirmation.info10") %></strong></div>
                <div class="col-6">
                  <span class="badge"><%= t("booking_confirmation.info11") %></span>
                </div>
              </div>
              <hr class="my-4">
              <!-- Action Buttons -->
              <div class="d-grid gap-2">
                <%= link_to t("booking_confirmation.info12"), guest_path(current_user), class: "backtohome btn btn-primary btn-lg" %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
