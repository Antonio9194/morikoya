<!-- app/views/bookings/confirmation.html.erb -->
<div class="container my-5 payment-page">
  <div class="row justify-content-center">
    <div class="col-md-9 col-lg-7">
      <!-- Success Card -->
      <div class="payment-card card success-card">
        <div class="card-body p-5 text-center">
             <div class="success-icon mb-4">
                <i class="fas fa-check-circle"></i>
             </div>
             <h2 class="success-title mb-3">Payment Successful</h2>
             <p class="success-subtitle mb-5 text-muted">Thank you, your booking is confirmed.</p>
             
              <!-- Booking Details -->
              <div class="booking-summary-section text-start">
                 <h5 class="section-title border-bottom pb-2 mb-4">Booking Details</h5>
                 
                 <div class="summary-row">
                    <span class="label">Booking ID</span>
                     <span class="value">#<%= @booking.id %></span>
                 </div>
                 
                 <div class="summary-row">
                    <span class="label">Room</span>
                     <span class="value"><%= @booking.room.name %></span>
                 </div>
                 
                  <div class="summary-row">
                    <span class="label">Check-in</span>
                     <span class="value"><%= @booking.start_date.strftime("%B %d, %Y") %></span>
                 </div>
                 
                  <div class="summary-row">
                    <span class="label">Check-out</span>
                     <span class="value"><%= @booking.end_date.strftime("%B %d, %Y") %></span>
                 </div>
                 
                 <div class="summary-row">
                    <span class="label">Total Paid</span>
                     <span class="value">¥<%= number_with_delimiter(@booking.total_price_cents) %></span>
                 </div>
                 
                 <div class="summary-row">
                    <span class="label">Status</span>
                     <span class="value"><span class="badge-paid">PAID</span></span>
                 </div>
              </div>
              
              <div class="d-grid gap-2 mt-5">
                <%= link_to "Return to Dashboard", guest_path(current_user), class: "btn payment-submit-btn" %>
              </div>
        </div>
      </div>
    </div>
  </div>
</div>
