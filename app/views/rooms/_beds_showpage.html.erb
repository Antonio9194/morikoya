<% if room.room_type == "A" %>
  <p class="mb-1"><strong><%= t("rooms.sofa_bed.one") %>:</strong> <%= @room.sofa_bed %></p>
  <p class="mb-1"><strong><%= t("rooms.bunk_bed.one") %>:</strong> <%= room.bunk %></p>
  <p class="mb-1"><strong><%= t("rooms.double_bed.one") %>:</strong> <%= room.double%></p>
<% elsif room.room_type == "B" %>
  <p class="mb-1"><strong><%= t("rooms.sofa_bed.one") %>:</strong> <%= @room.sofa_bed %></p>
  <p class="mb-1"><strong><%= t("rooms.bunk_bed.one") %>:</strong> <%= room.bunk %></p>
  <p class="mb-1"><strong><%= t("rooms.semidouble_bed.one") %>:</strong> <%= room.semi_double%></p>
<% else %>
  <p class="mb-1"><strong><%= t("rooms.sofa_bed.one") %>:</strong> <%= @room.sofa_bed %></p>
  <p class="mb-1"><strong><%= t("rooms.single_bed.one") %>:</strong> <%= room.single %></p>
  <p class="mb-1"><strong><%= t("rooms.double_bed.one") %>:</strong> <%= room.double%></p>
<% end %>
