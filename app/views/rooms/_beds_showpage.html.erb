<% if room.room_type == "A" %>
  <span><%= room.sofa_bed %> Sofa Bed</span>
  <span><%= room.bunk %> Bunk Bed</span>
  <span><%= room.double%> Double Bed</span>
<% elsif room.room_type == "B" %>
  <span><%= room.sofa_bed %> Sofa Bed</span>
  <span><%= room.bunk %> Bunk Bed</span>
  <span><%= room.semi_double%> Semi Double Bed</span>
<% else %>
  <span><%= room.sofa_bed %> Sofa Bed</span>
  <span><%= room.single %> Single Bed</span>
  <span><%= room.double%> Double Bed</span>
<% end %>
