<% room_c = rooms.where(room_type: "C").first%>
<% rooms_b = rooms.where(room_type: "B") %>
<% rooms_a = rooms.where(room_type: "A") %>
<!--Show room C first-->
<% if room_c.present? %>
  <div class="my-3">
    <h5 class="searchresult"><%= t("rooms.fit") %></h5>
    <%= render "rooms/room_c", room_c: room_c %>
  </div>
<% end %>
<!--Show room B-->
<% if rooms_b.any? %>
  <div class="my-3">
    <h5 class="searchresult"><%= t("rooms.choice1") %></h5>
    <%= render "rooms/other_rooms", other_rooms: rooms_b %>
  </div>
<% end %>
<!--Show room A-->
<% if rooms_a.count > 1 %>
  <div class="my-3">
    <h5 class="searchresult"><%= t("rooms.choice3") %></h5>
    <%= render "rooms/other_rooms", other_rooms: rooms_a %>
  </div>
<% end %>
<!--Case when only room A is available-->
<% if room_c.nil? && rooms_b.empty? && rooms_a.count > 1 %>
  <h5 class="searchresult"><%= t("rooms.choice4") %></h5>
  <%= render "rooms/other_rooms", other_rooms: rooms_a %>
<% end %>
<!--Case when no room is available (or available room is too small)-->
<% if room_c.nil? && rooms_b.empty? && other_rooms.count <= 1 %>
  <h5 class="p-3 text-warning-emphasis bg-warning-subtle border border-warning-subtle rounded-3"><%= t("rooms.fully_booked") %></h5>
<% end %>
