<div class="container my-5">
  <!-- Carousel with room photos -->
  <div id="roomCarousel" class="carousel slide carousel-fade mb-4 rounded" data-bs-ride="carousel">
    <div class="carousel-inner rounded-5">
      <% ["bathtub.jpg", "bedroom.jpg", "toilet.jpg"].each_with_index do |photo, index| %>
        <div class="carousel-item <%= 'active' if index == 0 %>">
          <%= image_tag photo, class: "d-block w-100 rounded-5", alt: "Room photo #{index + 1}", style: "height: 400px; object-fit: cover;" %>
        </div>
      <% end %>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#roomCarousel" data-bs-slide="prev">
      <span class="carousel-control-prev-icon" aria-hidden="true"></span>
      <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#roomCarousel" data-bs-slide="next">
      <span class="carousel-control-next-icon" aria-hidden="true"></span>
      <span class="visually-hidden">Next</span>
    </button>
  </div>
  <!-- Room info -->
  <div class="row">
    <div class="col-lg-8">
      <div class="card mb-4 rounded-5 shadow-sm">
        <div class="card-body">
          <h1 class="card-title"><%= @room.name %></h1>
          <p class="card-text text-muted"><%= @room.description %></p>
          <div class="row">
            <div class="col-md-4">
              <h5 class="text-primary">¥<%= number_with_delimiter(@room.price_per_night) %></h5>
              <small class="text-muted">per night</small>
            </div>
            <div class="col-md-4">
              <p class="mb-1"><strong>Size:</strong> <%= @room.size %> m²</p>
              <p class="mb-0"><strong>Capacity:</strong> <%= @room.capacity %> guests</p>
            </div>
            <!--Render beds depending on bed types-->
            <div class="col-md-4">
              <%= render "rooms/beds_showpage", room: @room %>
            </div>
            <!---->
          </div>
        </div>
      </div>
      <!-- List of amenities -->
      <div class="card mb-4 rounded-5 shadow-sm" style="overflow: hidden">
        <div class="card-header">
          <h5 class="mb-0">Amenities</h5>
        </div>
        <div class="card-body">
          <div class="row">
            <% @room.amenities.split(',').each do |amenity| %>
              <div class="col-md-6 mb-2">
                <i class="fas fa-check text-success me-2"></i><%= amenity.strip %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
    <!-- Booking calendar + Show searched date range in date input field -->
    <div class="col-lg-4">
      <div class="card position-sticky rounded-5 shadow-sm" style="top: 20px; overflow: hidden">
        <div class="card-header">
          <h5 class="mb-0">Make a booking</h5>
        </div>
        <div class="card-body">
          <div class="booking-form">
            <%= simple_form_for [@room, @booking], method: :post, url: room_bookings_path(@room) do |f| %>
              <%= f.input :start_date,
                as: :string, label: "Specify the booking duration",
                input_html: {
                  class: "chosen-dates",
                  data: { controller: "datepicker", datepicker_current_bookings_value: @room.booked_dates, datepicker_target: "input" },
                  value: [@check_in, @check_out].all? ? "#{@check_in} - #{@check_out}" : "" } %>
              <%= f.button :submit, "Book this room", class: "btn btn-primary w-100 rounded-4" %>
            <% end %>
          </div>
          <hr style="height: 2px;">
          <div class="tentative-booking-info">
            <!--Guests Num-->
            <% if @guest_num.present? %>
              <div class="row guest-num">
                <div class="title col-8">
                  <p class="card-text">Number of guests:</p>
                </div>
                <div class="value col-4">
                  <p class="card-text text-end"><%= @guest_num %> <%= @guest_num > 1 ? "person".pluralize : "person" %></p>
                </div>
              </div>
            <% end %>
            <!--Nights Num-->
            <div class="row night-num" data-controller="retrieve-dates" data-retrieve-dates-datepicker-outlet=".chosen-dates">
              <div class="title col-8">
                <p class="card-text">Number of nights:</p>
              </div>
              <div class="value col-4">
                <p class="card-text text-end" data-retrieve-dates-target="nightsNumDestination"></p>
              </div>
            </div>
            <!--Calculate and display Total Price-->
            <div data-controller="total-price-display" data-total-price-display-datepicker-outlet=".chosen-dates">
              <!--Price Per Night-->
              <div class="row price-per-night">
                <div class="title col-8">
                  <p class="card-text">Price per night:</p>
                </div>
                <div class="value col-4">
                  <p class="card-text text-end" data-total-price-display-target="pricePerNight">¥<%= number_with_delimiter(@room.price_per_night) %></p>
                </div>
              </div>
              <!--Total Price-->
              <div class="row total-price">
                <div class="title col-8">
                  <p class="card-text">Total price:</p>
                </div>
                <div class="value col-4">
                  <p class="card-text text-end" data-total-price-display-target="totalPrice"></p>
                </div>
              </div>
            </div>
            <!--End of Calculate and display Total Price-->
          </div>
        </div>
      </div>
    </div>
  </div>
  <!-- Pitch text -->
  <div class="row mt-5">
    <div class="col-12">
      <div class="card rounded-5 shadow-sm">
        <div class="card-body text-center">
          <h2 class="card-title">Why Book With Us?</h2>
          <p class="card-text">Experience unparalleled comfort and luxury in our meticulously designed rooms. Whether you're here for business or leisure, our amenities and services are tailored to meet your every need. Book now to enjoy exclusive offers and a memorable stay!</p>
        </div>
      </div>
    </div>
  </div>
</div>
