<div class="room-show-page">
  <!-- Hero Section -->
  <div class="room-hero mb-5">
    <div id="roomCarousel" class="carousel slide carousel-fade" data-bs-ride="carousel">
      <div class="carousel-inner">
        <% ["bathtub.jpg", "bedroom.jpg", "toilet.jpg"].each_with_index do |photo, index| %>
          <div class="carousel-item <%= 'active' if index == 0 %>">
            <%= image_tag photo, class: "d-block w-100 room-hero-image", alt: "Room photo #{index + 1}" %>
            <div class="carousel-overlay"></div>
          </div>
        <% end %>
      </div>
      <button class="carousel-control-prev" type="button" data-bs-target="#roomCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
      </button>
      <button class="carousel-control-next" type="button" data-bs-target="#roomCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
      </button>
    </div>
  </div>
  <div class="container rooms-page-wrapper pb-5 px-3 px-md-4">
    <div class="row g-4 g-lg-5">
      <!-- Room Details -->
      <div class="col-lg-7 col-xl-8">
        <div class="room-header mb-5 border-bottom pb-4">
          <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
            <h1 class="room-title display-4"><%= @room.name %></h1>
            <div class="room-price-tag text-end">
              <div class="price display-6">¥<%= number_with_delimiter(@room.price_per_night) %></div>
              <div class="unit text-muted"><%= t("rooms.info1") %></div>
            </div>
          </div>
          <div class="room-specs mt-4 d-flex gap-4 flex-wrap">
            <div class="spec-item">
              <i class="fa-solid fa-ruler-combined me-2"></i>
              <span><%= @room.size %> m²</span>
            </div>
            <div class="spec-item">
              <i class="fa-solid fa-user-group me-2"></i>
              <span><%= @room.capacity %> <%= t("rooms.guestnum") %></span>
            </div>
            <div class="spec-item">
              <i class="fa-solid fa-bed me-2"></i>
              <div class="d-flex flex-wrap gap-3">
                <%= render "rooms/beds_showpage", room: @room %>
              </div>
            </div>
          </div>
        </div>
        <div class="room-description mb-5">
          <h3 class="section-label mb-3"><%= t("rooms.descriptiontext") %></h3>
          <p class="lead text-muted"><%= t(@room.description) %></p>
        </div>
        <hr class="room-divider">
        <div class="room-amenities mb-5">
          <h3 class="section-label mb-4"><%= t("rooms.amenities_list") %></h3>
          <div class="row g-3">
            <% t("rooms.amenities").each do |key, label| %>
              <div class="col-md-6 col-lg-4">
                <div class="amenity-item">
                  <i class="fa-solid <%= amenity_icon(key) %> me-2"></i>
                  <span><%= label %></span>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
      <!-- Booking Widget -->
      <div class="col-lg-5 col-xl-4">
        <div class="booking-widget-wrapper sticky-top" style="top: 2rem; z-index: 10;">
          <div class="booking-widget p-4">
            <h3 class="widget-title mb-4"><%= t("rooms.book") %></h3>
            <div class="booking-form">
              <%= simple_form_for [@room, @booking], method: :post, url: room_bookings_path(@room) do |f| %>
                <%= f.input :start_date,
                  as: :string,
                  label: false,
                  placeholder: t("rooms.select"),
                  input_html: {
                    class: "chosen-dates form-control-lg mb-3",
                    data: { controller: "datepicker", datepicker_current_bookings_value: @room.booked_dates },
                    value: [@check_in, @check_out].all? ? "#{@check_in} - #{@check_out}" : "" } %>
                <%= f.button :submit, t("rooms.booking"), class: "btn btn-lg w-100 btn-primary" %>
              <% end %>
            </div>
            <div class="booking-summary mt-4 pt-4 border-top">
              <!-- Guests Info -->
              <% if @guest_num.present? %>
                <div class="d-flex justify-content-between mb-2">
                  <span class="text-muted"><%= t("rooms.guests") %></span>
                  <span class="fw-bold"><%= @guest_num %> <%= t("rooms.person", count: @guest_num) %></span>
                </div>
              <% end %>
              <!-- Nights Calculation -->
              <div class="d-flex justify-content-between mb-2" data-controller="retrieve-dates" data-retrieve-dates-datepicker-outlet=".chosen-dates">
                <span class="text-muted"><%= t("rooms.duration") %></span>
                <span class="fw-bold" data-retrieve-dates-target="nightsNumDestination"  data-retrieve-dates-label="<%= t('rooms.numnights', count: @numnights || 2) %>">-</span></span>
            </div>
            <!-- Price Calculation -->
            <div data-controller="total-price-display" data-total-price-display-datepicker-outlet=".chosen-dates">
              <div class="d-flex justify-content-between mb-2">
                <span class="text-muted"><%= t("rooms.price") %></span>
                <span class="fw-bold" data-total-price-display-target="pricePerNight">¥<%= number_with_delimiter(@room.price_per_night) %></span>
              </div>
              <div class="d-flex justify-content-between mt-3 pt-3 border-top">
                <span class="h5 mb-0"><%= t("rooms.total") %></span>
                <span class="h5 mb-0 text-primary" data-total-price-display-target="totalPrice">-</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
</div>
