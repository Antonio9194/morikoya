<div class="row search">
  <div class="col-6 col-md-6 dates">
    <%= image_tag "checkinout.png", alt: "calendar", style: "width: 25px;" %>
    <%= @check_in.strftime('%d %b') %> - <%= @check_out.strftime('%d %b') %>
  </div>
  <div class="col-6 col-md-6 guests">
    <%= image_tag "guests.png", alt: "calendar", style: "width: 25px;" %>
    <%= @guest_num %></div>
</div>
