<% room_c = rooms.where(room_type: "C").first%>
<% other_rooms = rooms.where.not(room_type: "C") %>
<% if room_c.present? && other_rooms.any?%>
  <!--Show room C first-->
  <div class="my-3">
    <h5 class="searchresult"><%= t("rooms.fit") %></h5>
    <%= render "rooms/room_c", room_c: room_c %>
  </div>
  <!--Show other rooms-->
  <div class="my-3">
    <h5 class="searchresult"><%= t("rooms.choice3") %></h5>
    <%= render "rooms/other_rooms", other_rooms: other_rooms %>
  </div>
<% end %>
<% if room_c.present? && other_rooms.empty? %>
  <!--Show room C only-->
  <h5 class="searchresult rounded-pill fs-4 my-3"><%= t("rooms.fit") %></h5>
  <%= render "rooms/room_c", room_c: room_c %>
<% end %>
<% if room_c.nil? && other_rooms.count > 1 %>
  <!--Show other rooms-->
  <h5 class="searchresult"><%= t("rooms.choice1") %></h5>
  <%= render "rooms/other_rooms", other_rooms: other_rooms %>
<% end %>
<% if room_c.nil? && other_rooms.count <= 1 %>
  <h5 class="p-3 text-warning-emphasis bg-warning-subtle border border-warning-subtle rounded-3"><%= t("rooms.fully_booked") %></h5>
<% end %>
