<!DOCTYPE html>
<html>
  <head>
    <title>Morikoya</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link href='https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css' rel='stylesheet'>
    <link href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css' rel='stylesheet'>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- ✅ ADD THIS: Mapbox CSS (required for the map to render) -->
    <link
      href="https://api.mapbox.com/mapbox-gl-js/v2.15.0/mapbox-gl.css"
      rel="stylesheet"
    />

    <link rel="manifest" href="<%= asset_path 'manifest.json' %>">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= render 'shared/ios_pwa_links' %>
    <script src="https://js.stripe.com/v3/"></script>
  </head>

  <body data-locale="<%= I18n.locale %>">
    <main>
      <%= render "shared/navbar" %>
      <%= render "shared/flashes" %>
      <%= yield %>
      <!--AI chatbot-->
      <%= render "shared/aichatbot", questions: @questions %>

      <!--Footer-->
        <% if controller_name == "rooms" && action_name == "index" %>
          <%= render "shared/footer_rooms" %>
        <% end %>
        <% if controller_name == "rooms" && action_name == "show" %>
          <%= render "shared/footer_rooms" %>
        <% end %>
        <% if controller_name == "pages" && action_name == "about_us" %>
          <%= render "shared/footer_rooms" %>
        <% end %>
        <% if controller_name == "pages" && action_name == "faqs" %>
          <%= render "shared/footer_rooms" %>
        <% end %>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/@fullcalendar/core@6.1.10/index.global.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@fullcalendar/daygrid@6.1.10/index.global.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@fullcalendar/interaction@6.1.10/index.global.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@fullcalendar/bootstrap5@6.1.10/index.global.min.js"></script>
  </body>
</html>
